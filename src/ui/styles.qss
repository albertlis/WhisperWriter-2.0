/* Tokens — see DESIGN.md
   bg #18191C · surface #202226 · input #26282D · line #33363C
   text #E8E6E1 · muted #8C8F96 · faint #5E6168
   Settings stay monochrome; colour belongs to the live status pill. */

/* ── Base ─────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #18191C;
    color: #E8E6E1;
    font-family: "Segoe UI Variable Text", "Segoe UI";
}

/* ── Tabs: text + underline, no boxes ─────────────── */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #33363C;
    background: #18191C;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    color: #8C8F96;
    padding: 8px 14px 9px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}
QTabBar::tab:selected { color: #E8E6E1; border-bottom: 2px solid #E8E6E1; }
QTabBar::tab:hover:!selected { color: #C9C7C2; }

QScrollArea { border: none; }

/* ── Inputs ───────────────────────────────────────── */
QLineEdit, QTextEdit, QSpinBox, QComboBox {
    background: #26282D;
    border: 1px solid #33363C;
    border-radius: 6px;
    padding: 5px 9px;
    color: #E8E6E1;
    selection-background-color: #4A4D55;
}
QLineEdit:hover, QTextEdit:hover, QSpinBox:hover, QComboBox:hover { border-color: #4A4D55; }
QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #C9C7C2; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: #5E6168; background: #202226; }
QLineEdit[echoMode="2"] { font-family: "Cascadia Mono", "Consolas"; }

QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #202226;
    border: 1px solid #33363C;
    selection-background-color: #33363C;
    selection-color: #E8E6E1;
    color: #E8E6E1;
    outline: none;
}

/* ── CheckBox ─────────────────────────────────────── */
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #4A4D55;
    border-radius: 4px;
    background: #26282D;
}
QCheckBox::indicator:hover { border-color: #8C8F96; }
QCheckBox::indicator:focus { border-color: #C9C7C2; }
QCheckBox::indicator:checked { background: #E8E6E1; border-color: #E8E6E1; }

/* ── Buttons: quiet by default, Save is the only filled one ── */
QPushButton {
    background: transparent;
    border: 1px solid #33363C;
    border-radius: 6px;
    padding: 6px 16px;
    color: #E8E6E1;
}
QPushButton:hover { background: #202226; border-color: #4A4D55; }
QPushButton:focus { border-color: #C9C7C2; }
QPushButton:pressed { background: #26282D; }
QPushButton:default, QPushButton#primaryButton {
    background: #E8E6E1;
    border-color: #E8E6E1;
    color: #18191C;
    font-weight: 600;
}
QPushButton#primaryButton:hover { background: #FFFFFF; }

/* ── Scrollbar ────────────────────────────────────── */
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #33363C; border-radius: 3px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #4A4D55; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* ── Labels ───────────────────────────────────────── */
QLabel { background: transparent; }
QLabel[role="description"] {
    color: #8C8F96;
    font-size: 9pt;
    padding-bottom: 14px;
}

QToolTip { background: #26282D; color: #E8E6E1; border: 1px solid #33363C; padding: 4px 6px; }

/* ── Key reference panel ──────────────────────────── */
QFrame#keyReferenceFrame {
    background: #202226;
    border: 1px solid #33363C;
    border-radius: 8px;
}
QLabel#keyRefGroupName { color: #8C8F96; font-size: 9pt; font-weight: 600; }
QLabel#keyRefKeys { color: #C9C7C2; font-size: 9pt; font-family: "Cascadia Mono", "Consolas"; }
